# /etc/systemd/system/bf2view.service
[Unit]
Description=BF2 demo viewer (gunicorn)
After=network.target

[Service]
User=bf2view
Group=bf2view
WorkingDirectory=/srv/bf2view/app
EnvironmentFile=/srv/bf2view/env
# ONE worker: parse jobs and their status live in the process; threads serve the requests
ExecStart=/srv/bf2view/venv/bin/gunicorn --workers 1 --threads 8 --timeout 120 --bind 127.0.0.1:8081 bf2demo.web.wsgi:app
Restart=on-failure
RestartSec=3

# hardening: the service can only write its cache
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/bf2view/cache
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
