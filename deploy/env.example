# /srv/bf2view/env  (copy of deploy/env.example, chmod 640, owner root:bf2view)
BF2VIEW_DEMOS=/srv/bf2view/demos
BF2VIEW_CACHE=/srv/bf2view/cache
# BF2VIEW_MAPS=/srv/bf2view/maps
# a public server shows only what is in BF2VIEW_DEMOS; set 1 only behind a password
BF2VIEW_UPLOAD=0
# recordings parsed at once: a 20 MB recording needs about 400 MB of RAM while it is parsed, a 2 hour one several GB
BF2VIEW_MAX_PARSE=1
BF2VIEW_MAX_UPLOAD_MB=400
# behind Caddy / nginx: take the visitor's address from X-Forwarded-For (needed for the per visitor limits to work)
BF2VIEW_BEHIND_PROXY=1
# Cloudflare in front: count CF-Connecting-IP (only safe when the proxy accepts Cloudflare's addresses only)
# BF2VIEW_BEHIND_CLOUDFLARE=1
# space for uploads and their parsed documents: the OLDEST upload is deleted when it is exceeded (published recordings are never deleted)
# BF2VIEW_QUOTA_MB=2500
# 1 = uploaded recordings appear in the public library (default: reachable by their link only)
# BF2VIEW_LIST_UPLOADS=0
# link of the project shown in the top bar (or put "github" in donate.json)
# BF2VIEW_REPO_URL=https://github.com/you/bf2-replay-viewer
BF2VIEW_CLIPS_PER_MIN=6
BF2VIEW_UPLOADS_PER_HOUR=6
# the support section (top bar button + card on the library page) appears once this is set, e.g. @my_name
# BF2VIEW_DONATE_TELEGRAM=
# crypto wallets and payment links: copy deploy/donate.example.json to /srv/bf2view/donate.json, fill it (chmod 640), then:
# BF2VIEW_DONATE_FILE=/srv/bf2view/donate.json
