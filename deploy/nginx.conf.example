# the same thing for nginx (/etc/nginx/sites-available/bf2view, then certbot --nginx -d bf2.example.com)
server {
    listen 80;
    server_name bf2.example.com;

    auth_basic "BF2 viewer";
    auth_basic_user_file /etc/nginx/bf2view.htpasswd;       # htpasswd -c /etc/nginx/bf2view.htpasswd beta

    gzip on;
    gzip_types application/json text/css application/javascript image/svg+xml;
    client_max_body_size 400m;                               # only matters when BF2VIEW_UPLOAD=1

    location / {
        proxy_pass http://127.0.0.1:18642;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
